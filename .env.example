# Browser-safe Supabase configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy projects may provide an anon key instead of a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials. Never expose these through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
# Controlled private Storage and public-client setup provisioning; server only.
# Supabase secret key only; never NEXT_PUBLIC_* or configuration downloads.
SUPABASE_SECRET_KEY=
SUPABASE_DIRECT_CONNECTION_URL=
# Optional downloaded provider root CA in PEM form; server-only, never a private key.
# Remote connections always verify the certificate and hostname, with or without it.
SUPABASE_DATABASE_CA_CERT=
# Optional official Supabase session-pooler override; keeps the secret URL unchanged.
SUPABASE_DATABASE_POOLER_HOST=
SUPABASE_DATABASE_POOLER_PORT=

# Server-only integration configuration. Use the exact deployed HTTPS origin.
# Keep both disabled until their separate authorization/verification gates pass.
TRADE_OS_INTEGRATION_ORIGIN=
TRADE_OS_MT5_ENABLED=false
TRADE_OS_MCP_ENABLED=false
# App-led public-client provisioning also requires reviewed migration + DB policy.
# Preparing setup never enables either integration or installs a companion.
TRADE_OS_INTEGRATION_SETUP_ENABLED=false
# Optional verified unsigned preview artifact metadata. Enable only after release
# asset byte/hash verification; fixed repository/filename, no arbitrary URL/secret.
TRADE_OS_COMPANION_PREVIEW_TAG=
TRADE_OS_COMPANION_PREVIEW_SHA256=
TRADE_OS_COMPANION_PREVIEW_BYTES=
# Desktop Chat is separately gated. Extension and companion must share the release tag.
TRADE_OS_CLAUDE_DESKTOP_SETUP_ENABLED=false
TRADE_OS_CLAUDE_DESKTOP_PREVIEW_TAG=
TRADE_OS_CLAUDE_DESKTOP_PREVIEW_SHA256=
TRADE_OS_CLAUDE_DESKTOP_PREVIEW_BYTES=
# Optional exact HTTPS staging origin for verified MCP-only consent handoff.
# Set only on the provider's consent host after review; does not enable its MCP API.
# Leave unset on staging, where consent and the bound MCP resource are local.
TRADE_OS_MCP_CONSENT_HANDOFF_ORIGIN=
